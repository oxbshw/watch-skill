{
  "name": "@watchskill/dsh-client-memory",
  "version": "0.1.0-preview.0",
  "description": "Browser half: the Memory product surfaces — taste, timeline, wiki, decisions, lessons, failures, sources",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/client/index.d.ts", "default": "./lib/client.js" },
    "./components": { "types": "./lib/client/components.d.ts", "default": "./lib/client/components.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "files": ["lib/**/*.js", "lib/**/*.js.map", "lib/**/*.d.ts"],
  "scripts": { "bundle": "tsdown" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@watchskill/dsh-client-brand": "workspace:^",
    "@watchskill/dsh-memory": "workspace:^"
  }
}
