{
  "name": "@deepwatch/dsh-live",
  "version": "0.1.0",
  "description": "Live mode — cursors, gaps, clocks, reconnect and a bounded buffer",
  "type": "module",
  "license": "MIT",
  "author": "Sayed Allam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxbshw/watch-skill.git",
    "directory": "workspace/packages/watch/live"
  },
  "homepage": "https://github.com/oxbshw/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/oxbshw/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "deepseek-harness",
    "watch-skill",
    "live",
    "capture"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./capture": {
      "types": "./lib/capture.d.ts",
      "default": "./lib/capture.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./components": {
      "types": "./lib/client/components.d.ts",
      "default": "./lib/client/components.js"
    },
    "./live-mode": {
      "types": "./lib/client/live-mode.d.ts",
      "default": "./lib/client/live-mode.js"
    },
    "./package.json": "./package.json",
    "./sources-catalogue": {
      "types": "./lib/sources-catalogue.d.ts",
      "default": "./lib/sources-catalogue.js"
    },
    "./synthetic-source": {
      "types": "./lib/synthetic-source.d.ts",
      "default": "./lib/synthetic-source.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "dependencies": {
    "@deepwatch/dsh-client-brand": "workspace:^",
    "@deepwatch/dsh-contracts": "workspace:^",
    "@deepwatch/dsh-workspace": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
