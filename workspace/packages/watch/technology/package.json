{
  "name": "@deepwatch/dsh-technology",
  "version": "0.1.0-preview.0",
  "description": "Technology descriptors, capability lifecycle, and role bindings over DSH Models and Providers",
  "type": "module",
  "license": "MIT",
  "author": "Sayed Allam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxbshw/watch-skill.git",
    "directory": "workspace/packages/watch/technology"
  },
  "homepage": "https://github.com/oxbshw/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/oxbshw/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "deepseek-harness",
    "watch-skill",
    "technology",
    "inventory"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./attestation": {
      "types": "./lib/attestation.d.ts",
      "default": "./lib/attestation.js"
    },
    "./budget": {
      "types": "./lib/budget.d.ts",
      "default": "./lib/budget.js"
    },
    "./delegation": {
      "types": "./lib/delegation.d.ts",
      "default": "./lib/delegation.js"
    },
    "./descriptors": {
      "types": "./lib/descriptors.d.ts",
      "default": "./lib/descriptors.js"
    },
    "./observation": {
      "types": "./lib/observation.d.ts",
      "default": "./lib/observation.js"
    },
    "./package.json": "./package.json",
    "./provenance": {
      "types": "./lib/provenance.d.ts",
      "default": "./lib/provenance.js"
    },
    "./routing": {
      "types": "./lib/routing.d.ts",
      "default": "./lib/routing.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@deepwatch/dsh-contracts": "workspace:^"
  }
}
