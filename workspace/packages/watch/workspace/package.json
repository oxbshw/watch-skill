{
  "name": "@deepwatch/dsh-workspace",
  "version": "0.1.0",
  "description": "Browser half: the DeepWatch product shell — modes, header, inspector and sensory timeline",
  "type": "module",
  "license": "MIT",
  "author": "Sayed Allam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxbshw/watch-skill.git",
    "directory": "workspace/packages/watch/workspace"
  },
  "homepage": "https://github.com/oxbshw/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/oxbshw/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "deepseek-harness",
    "watch-skill",
    "workspace",
    "modes"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./components": {
      "types": "./lib/client/components.d.ts",
      "default": "./lib/client/components.js"
    },
    "./mode-views": {
      "types": "./lib/client/mode-views.d.ts",
      "default": "./lib/client/mode-views.js"
    },
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/client/surface.d.ts",
      "default": "./lib/client/surface.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "dependencies": {
    "@deepwatch/dsh-client-brand": "workspace:^",
    "@deepwatch/dsh-contracts": "workspace:^",
    "@deepwatch/dsh-trajectory": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
