{
  "name": "@deepwatch/cli",
  "version": "0.1.0-preview.0",
  "description": "DeepWatch — set up and run the agent workspace built on DeepSeek Harness and powered by Watch Skill",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxbshw/watch-skill.git",
    "directory": "workspace/packages/watch/cli"
  },
  "homepage": "https://github.com/oxbshw/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/oxbshw/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "watch-skill",
    "deepseek-harness",
    "agent",
    "evidence",
    "verification"
  ],
  "bin": {
    "deepwatch": "./lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepwatch/dsh-bundle": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
