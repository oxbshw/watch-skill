{
  "name": "@watchskill/dsh-bundle",
  "version": "0.1.0-preview.0",
  "description": "Watch for DSH \u2014 the installable Watch capability bundle for a DeepSeek Harness profile",
  "type": "module",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "variants": {
        "full": "./cordis.patch.yml",
        "media": "./variants/media.patch.yml",
        "browser": "./variants/browser.patch.yml",
        "memory": "./variants/memory.patch.yml",
        "document": "./variants/document.patch.yml"
      }
    }
  },
  "files": [
    "cordis.patch.yml",
    "variants/*.yml",
    "README.md"
  ],
  "dependencies": {
    "@watchskill/dsh-client-brand": "workspace:^",
    "@watchskill/dsh-client-evidence": "workspace:^",
    "@watchskill/dsh-client-memory": "workspace:^",
    "@watchskill/dsh-client-settings": "workspace:^",
    "@watchskill/dsh-core-bridge": "workspace:^",
    "@watchskill/dsh-library": "workspace:^",
    "@watchskill/dsh-live": "workspace:^",
    "@watchskill/dsh-memory": "workspace:^",
    "@watchskill/dsh-technology": "workspace:^",
    "@watchskill/dsh-tools": "workspace:^",
    "@watchskill/dsh-trajectory": "workspace:^",
    "@watchskill/dsh-workspace": "workspace:^"
  }
}
