{
  "name": "@deepwatch/dsh-library",
  "version": "0.1.0-preview.0",
  "description": "Library — sources, revisions, index state, search, facets and collections",
  "type": "module",
  "license": "MIT",
  "author": "Sayed Allam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxbshw/watch-skill.git",
    "directory": "workspace/packages/watch/library"
  },
  "homepage": "https://github.com/oxbshw/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/oxbshw/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "deepseek-harness",
    "watch-skill",
    "library",
    "index"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepwatch/dsh-client-remotes",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./components": {
      "types": "./lib/client/components.d.ts",
      "default": "./lib/client/components.js"
    },
    "./index-store": {
      "types": "./lib/index-store.d.ts",
      "default": "./lib/index-store.js"
    },
    "./library-mode": {
      "types": "./lib/client/library-mode.d.ts",
      "default": "./lib/client/library-mode.js"
    },
    "./read-plane": {
      "types": "./lib/client/read-plane.d.ts",
      "default": "./lib/client/read-plane.js"
    },
    "./package.json": "./package.json",
    "./search-view": {
      "types": "./lib/client/search-view.d.ts",
      "default": "./lib/client/search-view.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "dependencies": {
    "@deepwatch/dsh-client-brand": "workspace:^",
    "@deepwatch/dsh-contracts": "workspace:^",
    "@deepwatch/dsh-technology": "workspace:^",
    "@deepwatch/dsh-workspace": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
