    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "managed": "node scripts/gen-managed-runtime.mjs",
    "managed:check": "node scripts/gen-managed-runtime.mjs --check",
    "ocr:benchmark": "node scripts/ocr-benchmark.mjs",
    "ocr:check": "node scripts/ocr-benchmark.mjs --check",
