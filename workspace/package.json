{
  "name": "@deepwatch/monorepo",
  "version": "0.1.0-preview.0",
  "description": "DeepWatch — an evidence-native agent distribution built on DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "bench": "node --expose-gc scripts/bench.mjs",
