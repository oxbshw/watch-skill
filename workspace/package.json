    "providers": "node scripts/gen-provider-inventory.mjs",
    "providers:check": "node scripts/gen-provider-inventory.mjs --check",
    "release:artifacts": "npm run pack && npm run verify:packed && npm run verify:packed-contents && npm run verify:packed-exec && npm run release:seal && npm run release:provenance",
    "release:check": "node scripts/gen-release-manifest.mjs --check",
    "release:manifest": "node scripts/gen-release-manifest.mjs",
    "release:provenance": "node scripts/verify-provenance.mjs --artifacts .release-artifacts --manifest .release-artifacts-provenance.json",
    "release:seal": "node scripts/gen-provenance-manifest.mjs --artifacts .release-artifacts",
    "sbom": "node scripts/gen-sbom.mjs",
    "slots": "node scripts/gen-dsh-slots.mjs",
    "slots:check": "node scripts/gen-dsh-slots.mjs --check",
    "smoke:boot": "node scripts/boot-smoke.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:install": "node scripts/install-smoke.mjs",
    "smoke:upgrade": "node scripts/upgrade-smoke.mjs",
    "status": "node scripts/gen-status.mjs",
    "status:check": "node scripts/gen-status.mjs --check",
    "test": "node --test --test-reporter spec \"tests/**/*.test.mjs\"",
    "typert:check": "node scripts/gen-typert.mjs --check",
    "typert:generate": "node scripts/gen-typert.mjs",
    "upstream:sync": "node scripts/upstream-sync.mjs",
    "upstream:verify": "node scripts/upstream-sync.mjs --verify",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:clean-build": "node scripts/verify-clean-build.mjs",
    "verify:client": "node scripts/verify-client-bundles.mjs",
    "verify:commits": "node scripts/verify-commits.mjs",
    "verify:desktop": "node scripts/verify-desktop-security.mjs",
    "verify:artifacts": "node scripts/verify-tracked-artifacts.mjs",
    "verify:graph": "node scripts/verify-package-graph.mjs",
    "verify:pack-reproducible": "node scripts/verify-pack-reproducible.mjs",
    "verify:packed": "node scripts/verify-packed-install.mjs",
    "verify:packed-contents": "node scripts/verify-packed-contents.mjs",
    "verify:agent-profile": "node scripts/verify-agent-profile.mjs",
    "verify:shell-containment": "node scripts/verify-shell-containment.mjs",
    "verify:packed-exec": "node scripts/verify-packed-exec.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:portability": "node scripts/verify-portability.mjs",
    "verify:publishable": "node scripts/verify-publishable.mjs",
    "verify:release-sequence": "node scripts/verify-release-sequence.mjs",
    "verify:release-surface": "node scripts/verify-release-surface.mjs",
    "verify:signing": "node scripts/verify-signing.mjs",
    "verify:slots": "node scripts/verify-slots.mjs",
    "verify:typert-face": "node scripts/verify-typert-face.mjs",
    "verify:verdict": "node scripts/verify-verdict-authority.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-gateway": "catalog:",
    "@deepseek-ai/dsh-typert-generator": "catalog:",
    "@deepseek-ai/dsh-typert-registry": "catalog:",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@deepwatch/dsh-adapters": "workspace:*",
    "@deepwatch/dsh-client-brand": "workspace:*",
    "@deepwatch/dsh-client-evidence": "workspace:*",
    "@deepwatch/dsh-client-memory": "workspace:*",
    "@deepwatch/dsh-contracts": "workspace:*",
    "@deepwatch/dsh-core-bridge": "workspace:*",
    "@deepwatch/dsh-library": "workspace:*",
    "@deepwatch/dsh-live": "workspace:*",
    "@deepwatch/dsh-memory": "workspace:*",
    "@deepwatch/dsh-sdk": "workspace:*",
    "@deepwatch/dsh-technology": "workspace:*",
    "@deepwatch/dsh-tenancy": "workspace:*",
    "@deepwatch/dsh-tools": "workspace:*",
    "@deepwatch/dsh-trajectory": "workspace:*",
    "@deepwatch/dsh-wiki": "workspace:*",
    "@deepwatch/dsh-workspace": "workspace:*",
    "@deepwatch/desktop": "workspace:*",
    "eslint": "^9.39.5",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "patchedDependencies": {
      "@deepseek-ai/dsh-typert-generator@0.1.1-rc.2": "patches/@deepseek-ai__dsh-typert-generator@0.1.1-rc.2.patch"
