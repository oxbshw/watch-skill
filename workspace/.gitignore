node_modules/
# Anchored to where the build actually writes. A bare `lib/` also caught
# `scripts/lib/`, which is source, and silently dropped it from a commit --
# leaving `doctor.mjs` importing a module that was not in the repository.
packages/*/*/lib/
apps/*/lib/
dist/
out/
.turbo/
*.tsbuildinfo
.DS_Store
*.log

# The pinned upstream checkout is script-managed, never vendored.
upstream/deepseek-harness/

# Local profile scratch used by install smoke tests.
.dsh-home/

# Local visual-QA evidence. Captured from a running app, not a build input.
qa/
