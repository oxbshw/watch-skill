{
  "name": "@watchskill/watch-desktop",
  "version": "0.1.0-preview.0",
  "description": "Watch Workspace \u2014 an Electron shell around the same Workspace packages",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "main.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "electron main.mjs"
  },
  "dependencies": {
    "@watchskill/dsh-contracts": "workspace:^",
    "@watchskill/dsh-core-bridge": "workspace:^",
    "@watchskill/dsh-workspace": "workspace:^"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "productName": "Watch Workspace",
  "build": {
    "appId": "com.watchskill.workspace",
    "productName": "Watch Workspace",
    "win": {
      "icon": "../../packages/watch/brand/assets/watch-orca.ico"
    },
    "mac": {
      "icon": "../../packages/watch/brand/assets/watch-orca-512.png"
    },
    "linux": {
      "icon": "../../packages/watch/brand/assets/watch-orca-512.png"
    }
  }
}
